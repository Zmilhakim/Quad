{
  "name": "quadpad-contracts",
  "version": "1.0.0",
  "description": "Quadpad: a launchpad whose pools charge 4% and open every launch at the same price, on Uniswap v4",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "compile": "node compile.mjs",
    "pretest": "node compile.mjs",
    "test": "node --test test/*.test.mjs",
